{
  "title": "Splash request traces",
  "tags": ["splash", "inference", "llm", "traces"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Requests per minute",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(splash_obs_requests_total[1m])) * 60" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "series": "" } },
      "fieldConfig": { "defaults": { "unit": "req/min" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Error rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(splash_obs_errors_total[5m])) * 60" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "series": "" } },
      "fieldConfig": { "defaults": { "unit": "errors/min", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Client aborts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(splash_obs_client_disconnects_total[5m])) * 60" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "series": "" } },
      "fieldConfig": { "defaults": { "unit": "aborts/min" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Tokens in / out (last 1m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(splash_obs_tokens_total{kind=\"prompt\"}[1m])) * 60", "legend": "prompt tokens" },
        { "refId": "B", "expr": "sum(rate(splash_obs_tokens_total{kind=\"completion\"}[1m])) * 60", "legend": "completion tokens" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "series": "" } },
      "fieldConfig": { "defaults": { "unit": "tokens" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Tool calls per minute",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(splash_obs_tool_calls_total[1m])) * 60" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "series": "" } },
      "fieldConfig": { "defaults": { "unit": "calls/min" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Splash reachable",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "splash_obs_upstream_available" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "series": "" } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] }
    },

    {
      "id": 7,
      "title": "Requests by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(splash_obs_requests_total[1m])) by (model)" }
      ],
      "fieldConfig": { "defaults": { "unit": "req/s" }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Errors by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(splash_obs_errors_total[5m])) by (type)" }
      ],
      "fieldConfig": { "defaults": { "unit": "errors/s" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Duration and TTFT through the proxy",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(splash_obs_request_duration_seconds_bucket[5m])) by (le))", "legend": "duration p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(splash_obs_request_duration_seconds_bucket[5m])) by (le))", "legend": "duration p95" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum(rate(splash_obs_ttft_seconds_bucket[5m])) by (le))", "legendFormat": "streaming TTFT p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 10,
      "title": "Token volume",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(splash_obs_tokens_total{kind=\"prompt\"}[1m]))", "legend": "prompt tokens/s" },
        { "refId": "B", "expr": "sum(rate(splash_obs_tokens_total{kind=\"completion\"}[1m]))", "legend": "completion tokens/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "tokens/s" }, "overrides": [] }
    },
    {
      "id": 13,
      "title": "Stream chunk gap (proxy estimate)",
      "description": "p50/p95 of each streaming request's mean gap between TCP reads, grouped by model. This is a transport-level estimate, not true per-token ITL: chunks can contain several tokens or metadata. No traffic in the last 5 minutes produces no data, not zero latency.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, model) (rate(splash_obs_itl_seconds_bucket[5m]))) * 1000", "legendFormat": "{{model}} p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, model) (rate(splash_obs_itl_seconds_bucket[5m]))) * 1000", "legendFormat": "{{model}} p95" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "decimals": 1 }, "overrides": [] }
    },
    {
      "id": 11,
      "title": "Failed requests (metadata only)",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{app=\"splash-obs\", status_class=~\"4xx|5xx\"}", "queryType": "range", "maxLines": 100 }
      ]
    },
    {
      "id": 12,
      "title": "All traces",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{app=\"splash-obs\"}", "queryType": "range", "maxLines": 200 }
      ]
    }
  ]
}
